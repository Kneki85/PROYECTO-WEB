<?xml version="1.0" encoding="UTF-8"?>
<!-- Contexto SOLO para la nube (Render). El de web/META-INF se sigue usando en local. -->
<Context>
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax"/>
    <!-- Detrás del proxy de Render, toma la IP real del visitante (la usa el bloqueo por intentos fallidos) -->
    <Valve className="org.apache.catalina.valves.RemoteIpValve"/>
</Context>
